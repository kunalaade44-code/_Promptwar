# GuruDev Production & Local Environment Configuration
# Copy this file to .env for local development

# ==========================================
# 1. Google Gemini AI Configuration
# ==========================================
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 2. Database (Neon PostgreSQL)
# ==========================================
# For Production (Neon PostgreSQL):
# Format: postgresql://<user>:<password>@<neon_hostname>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-dry-leaf-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# For Offline Local Development (optional SQLite fallback):
# DATABASE_URL=sqlite:///./dev_gurudev.db

# ==========================================
# 3. Security & Authentication (JWT)
# ==========================================
# Generate a secure 32+ character random secret:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==========================================
# 4. Application Environment
# ==========================================
APP_ENV=production
PROJECT_NAME="GuruDev Cognitive Audit Platform"
